/* ============================================================
   RAYMOND DIGITAL — site interactions
   Modules: config, header state, mobile nav, active links,
   reveal-on-scroll, service modal, form validation + mailto,
   back-to-top, footer year.
   Safe to include on any page (all lookups are null-guarded).
   ============================================================ */

"use strict";

/* ---------- 0. SITE CONFIG ----------------------------------
   >>> REQUIRED before launch: set your real email address <<<
   The inquiry form composes a message and opens the visitor's
   email app addressed to this address.                        */
const CONFIG = {
  contactEmail: "", // e.g. "hello@yourdomain.com"
};

/* ---------- helpers ---------- */
const $  = (sel, ctx = document) => ctx.querySelector(sel);
const $$ = (sel, ctx = document) => Array.from(ctx.querySelectorAll(sel));
const prefersReducedMotion =
  window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

/* ---------- 1. header scrolled state + back-to-top ---------- */
const header = $("#site-header");
const backToTop = $("#back-to-top");

function onScroll() {
  const y = window.scrollY;
  if (header) header.classList.toggle("is-scrolled", y > 8);
  if (backToTop) {
    if (y > 640) {
      backToTop.hidden = false;
      // next frame so the transition plays
      requestAnimationFrame(() => backToTop.classList.add("show"));
    } else {
      backToTop.classList.remove("show");
    }
  }
}
window.addEventListener("scroll", onScroll, { passive: true });
onScroll();

if (backToTop) {
  backToTop.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: prefersReducedMotion ? "auto" : "smooth" });
  });
}

/* ---------- 2. mobile navigation ---------- */
const navToggle = $("#nav-toggle");
const siteNav = $("#primary-nav");

function setMenu(open) {
  if (!navToggle || !siteNav) return;
  document.body.classList.toggle("nav-open", open);
  navToggle.classList.toggle("is-active", open);
  navToggle.setAttribute("aria-expanded", String(open));
  navToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
}

if (navToggle && siteNav) {
  navToggle.addEventListener("click", () =>
    setMenu(!document.body.classList.contains("nav-open"))
  );

  // close when a nav link or CTA inside the panel is used
  siteNav.addEventListener("click", (e) => {
    if (e.target.closest("a")) setMenu(false);
  });

  // close on Escape / click outside
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && document.body.classList.contains("nav-open")) {
      setMenu(false);
      navToggle.focus();
    }
  });
  document.addEventListener("click", (e) => {
    if (
      document.body.classList.contains("nav-open") &&
      !siteNav.contains(e.target) &&
      !navToggle.contains(e.target)
    ) {
      setMenu(false);
    }
  });
}

/* ---------- 3. active section highlight ---------- */
const navLinks = $$(".site-nav-link").filter((a) => a.hash);
if ("IntersectionObserver" in window && navLinks.length) {
  const sections = navLinks
    .map((a) => $(a.hash))
    .filter(Boolean);

  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((a) =>
          a.classList.toggle("active", a.hash === `#${entry.target.id}`)
        );
      });
    },
    { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
  );
  sections.forEach((s) => spy.observe(s));
}

/* ---------- 4. reveal-on-scroll (staggered, self-cleaning) ---------- */
const revealEls = $$(".reveal");
if (revealEls.length) {
  if (prefersReducedMotion || !("IntersectionObserver" in window)) {
    revealEls.forEach((el) => el.classList.add("reveal-in"));
  } else {
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          obs.unobserve(el);

          // stagger up to 6 siblings inside the same container
          const siblings = $$(".reveal", el.parentElement);
          const delay = Math.min(Math.max(siblings.indexOf(el), 0), 5) * 70;

          setTimeout(() => {
            el.classList.add("reveal-in");
            // once revealed, drop helper classes so component
            // hover/focus transitions work as designed
            const finish = () => el.classList.remove("reveal", "reveal-in");
            el.addEventListener("transitionend", finish, { once: true });
            setTimeout(finish, 1500); // safety net (e.g. hidden tabs)
          }, delay);
        });
      },
      { threshold: 0.14, rootMargin: "0px 0px -8% 0px" }
    );
    revealEls.forEach((el) => io.observe(el));
  }
}

