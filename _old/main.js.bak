const modal = $("#service-modal");
if (modal && typeof modal.showModal === "function") {
  let currentService = "";

  function openModal(key) {
    const data = SERVICE_DATA[key];
    if (!data) return;
    currentService = key;
    $("#modal-title").textContent = data.title;
    $("#modal-desc").textContent = data.desc;
    $("#modal-list").innerHTML = "";
    data.points.forEach((p) => {
      const li = document.createElement("li");
      li.textContent = p;
      $("#modal-list").appendChild(li);
    });
    modal.showModal();
  }

  $$("[data-service]").forEach((btn) =>
    btn.addEventListener("click", () => openModal(btn.dataset.service))
  );

  const closeModal = () => modal.close();
  $("#modal-close").addEventListener("click", closeModal);
  $("#modal-dismiss").addEventListener("click", closeModal);

  // click on backdrop closes the dialog
  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  // preselect service in the contact form and jump there
  $("#modal-request").addEventListener("click", () => {
    const select = $("#cf-service");
    closeModal();
    if (select) select.value = currentService;
    const contact = $("#contact");
    if (contact) contact.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth" });
  });
}

/* ---------- 6. inquiry form validation + mailto ---------- */
const form = $("#inquiry-form");
if (form) {
  const statusEl = $("#form-status");
  const fields = {
    name: { el: $("#cf-name"), err: $("#err-name") },
    email: { el: $("#cf-email"), err: $("#err-email") },
    phone: { el: $("#cf-phone"), err: null },
    service: { el: $("#cf-service"), err: $("#err-service") },
    message: { el: $("#cf-message"), err: $("#err-message") },
  };

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function setError(f, hasError) {
    if (!f.el) return;
    f.el.setAttribute("aria-invalid", String(hasError));
    if (f.err) f.err.hidden = !hasError;
  }

  function validateField(key) {
    const f = fields[key];
    if (!f || !f.el) return true;
    const v = f.el.value.trim();

    switch (key) {
      case "name":
        return pass(v.length >= 2);
      case "email":
        return pass(EMAIL_RE.test(v));
      case "service":
        return pass(v !== "");
      case "message":
        return pass(v.length >= 10);
      default:
        return pass(true); // phone is optional
    }

    function pass(ok) {
      setError(f, !ok);
      return ok;
    }
  }

  // live re-validation once a field was flagged
  Object.keys(fields).forEach((key) => {
    const f = fields[key];
    if (!f || !f.el) return;
    f.el.addEventListener("blur", () => validateField(key));
    f.el.addEventListener("input", () => {
      if (f.el.getAttribute("aria-invalid") === "true") validateField(key);
    });
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!statusEl) return;

    const results = Object.keys(fields).map(validateField);
    const firstInvalid = Object.values(fields).find(
      (f) => f.el && f.el.getAttribute("aria-invalid") === "true"
    );
    if (firstInvalid) {
      firstInvalid.el.focus();
      return;
    }

    const name = fields.name.el.value.trim();
    const email = fields.email.el.value.trim();
    const phone = fields.phone.el.value.trim();
    const serviceText =
      fields.service.el.options[fields.service.el.selectedIndex].text;
    const message = fields.message.el.value.trim();

    const bodyLines = [
      `Name: ${name}`,
      `Email: ${email}`,
      `Phone/WhatsApp: ${phone || "—"}`,
      `Service needed: ${serviceText}`,
      "",
      "Message:",
      message,
    ];

    if (!CONFIG.contactEmail) {
      statusEl.className = "form-status err";
      statusEl.textContent =
        "Thank you! Online submission isn't switched on yet — please reach us directly by phone or WhatsApp.";
      console.warn("Raymond Digital site: set CONFIG.contactEmail in js/main.js to enable the inquiry form.");
      return;
    }

    const subject = encodeURIComponent(`Service inquiry — ${serviceText} (${name})`);
    const body = encodeURIComponent(bodyLines.join("\n"));
    window.location.href = `mailto:${CONFIG.contactEmail}?subject=${subject}&body=${body}`;

    statusEl.className = "form-status ok";
    statusEl.textContent =
      "Your email app should now open with the message ready to send. Thank you!";
    form.reset();
  });
}

/* ---------- 7. footer year ---------- */
const yearEl = $("#year");
if (yearEl) yearEl.textContent = new Date().getFullYear();
